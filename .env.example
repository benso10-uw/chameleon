# Copy to .env (git-ignored) and fill in. Real environment variables override these.

# Hosted OpenAI-compatible model, for development only: the scoring
# container runs offline, so the submission cannot call this.
CHAMELEON_LLM_BASE_URL=https://api.cantabile.ai/v1
CHAMELEON_LLM_MODEL=qwen/qwen3.6-35b-a3b
CHAMELEON_LLM_API_KEY=

# Or a local Ollama model (used only when the hosted settings above are unset):
# CHAMELEON_OLLAMA_MODEL=qwen2.5:7b
# CHAMELEON_OLLAMA_HOST=http://127.0.0.1:11434
